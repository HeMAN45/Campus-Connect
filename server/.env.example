# Copy to .env and adjust. Never commit .env.
PORT=4000
NODE_ENV=development

# At least 32 random characters in production.
JWT_SECRET=replace-with-a-long-random-string-of-32-plus-chars
SESSION_DAYS=7

ALLOWED_EMAIL_DOMAIN=dypiu.ac.in

# PostgreSQL connection string. Use Neon for production.
# Local: postgresql://localhost:5432/campus_connect
# Neon:  postgresql://user:pass@ep-xxx.region.aws.neon.tech/campus_connect?sslmode=require
DATABASE_URL=postgresql://localhost:5432/campus_connect

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5
CLIENT_ORIGIN=http://localhost:5173

# Leave SMTP_HOST empty in development: sign-up codes are printed in the server terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Campus Connect <no-reply@dypiu.ac.in>

# Emails that become platform admins when they register.
ADMIN_EMAILS=
